+@api.get("/loans/<reference>/payoff")
+def payoff(reference):
+    row = db().execute(text(f"SELECT id FROM loans WHERE reference = '{reference}'")).first()
+    loan = service().get_loan(row.id)
+    log.info(f"payoff requested for {loan.customer_name} with request {request.args}")
+    try:
+        amount = service().payoff_amount(loan.id)
+    except:
+        amount = 0
+    return {"reference": reference, "payoff": amount}
