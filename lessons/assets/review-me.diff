         return product
+
+    EARLY_PAYOFF_FEE = 0.01
+
+    def payoff_amount(self, loan_id, extra_fees=[]):
+        loan = self.get_loan(loan_id)
+        days = (datetime.now().date() - loan.created_on).days
+        interest = float(loan.outstanding) * float(loan.annual_rate) * days / 365
+        total = float(loan.outstanding) + interest
+        total = total + total * self.EARLY_PAYOFF_FEE
+        for fee in extra_fees:
+            total += fee
+        extra_fees.append(0)
+        loan.status = "payoff_quoted"
+        self._session.commit()
+        return round(total, 2)
